{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "PORT=3000 BASE_PATH=/ pnpm --filter @workspace/pop-person run build",
  "outputDirectory": "artifacts/pop-person/dist/public",
  "rewrites": [
    { "source": "/privacy", "destination": "/" },
    { "source": "/privacidade", "destination": "/" },
    { "source": "/terms", "destination": "/" },
    { "source": "/termos-de-servico", "destination": "/" }
  ]
}