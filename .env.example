# Vercel: build-time variables for the web app.
# Use the public Railway service URL without a trailing slash.
VITE_API_URL=https://your-railway-service.up.railway.app
# Optional; when omitted, the frontend derives wss:// from VITE_API_URL.
VITE_WS_URL=wss://your-railway-service.up.railway.app

# Railway: runtime variables for the API.
NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://user:password@host:5432/database
SESSION_SECRET=replace-with-a-long-random-secret
# Comma-separated exact Vercel origins, including preview/custom domains as needed.
CORS_ORIGIN=https://your-vercel-project.vercel.app

# Optional if the API's access-location integration uses Supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key